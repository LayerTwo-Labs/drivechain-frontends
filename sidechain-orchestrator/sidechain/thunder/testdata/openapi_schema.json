    "balance": {
      "post": {
        "description": "Get balance in sats",
        "operationId": "balance",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "total_sats",
                    "available_sats"
                  ],
                  "properties": {
                    "available_sats": {
                      "type": "integer",
                      "format": "u-int64",
                      "minimum": 0
                    },
                    "total_sats": {
                      "type": "integer",
                      "format": "u-int64",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "connect_block": {
      "post": {
        "description": "Connect a block template for which a BMM request was included in the\nspecified mainchain block. Returns `true` if it was accepted as the new\ntip.",
        "operationId": "connect_block",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "block": {
                    "type": "object",
                    "required": [
                      "header",
                      "body"
                    ],
                    "properties": {
                      "body": {
                        "$ref": "#/components/schemas/Body"
                      },
                      "header": {
                        "$ref": "#/components/schemas/Header"
                      }
                    }
                  },
                  "main_block_hash": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
