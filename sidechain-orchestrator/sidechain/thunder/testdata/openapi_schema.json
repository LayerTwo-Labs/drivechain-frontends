    "sign_transaction": {
      "post": {
        "description": "Sign a transaction, and optionally broadcast it.",
        "operationId": "sign_transaction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "broadcast": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "transaction": {
                    "type": "object",
                    "required": [
                      "inputs",
                      "proof",
                      "outputs"
                    ],
                    "properties": {
                      "inputs": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": false,
                          "prefixItems": [
                            {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "required": [
