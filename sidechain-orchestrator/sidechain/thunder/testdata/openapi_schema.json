    "get_block_template": {
      "post": {
        "description": "Assemble a block to blind merge mine, without requesting BMM for it.\nThe caller requests BMM for `critical_hash` itself, then passes the\nblock back to `connect_block`.",
        "operationId": "get_block_template",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "critical_hash",
                    "block",
                    "fees_sats"
                  ],
                  "properties": {
                    "block": {
                      "$ref": "#/components/schemas/Block",
                      "description": "Block to pass to `connect_block` once its BMM request is included in a\nmainchain block"
                    },
                    "critical_hash": {
                      "$ref": "#/components/schemas/BlockHash",
                      "description": "Block hash to commit to in a BMM request"
                    },
                    "fees_sats": {
                      "type": "integer",
                      "format": "u-int64",
                      "description": "Fees collected by the transactions in the block, in sats",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
